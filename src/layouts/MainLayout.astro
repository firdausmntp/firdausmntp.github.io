---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title = "Firdaus Satrio Utomo | Web & Mobile Developer",
  description = "Portofolio Firdaus Satrio Utomo - Web & Mobile Developer spesialisasi Flutter, Laravel, Node.js, dan Reverse Engineering. Mahasiswa Informatika UNTIRTA.",
  image = "https://firdausmntp.github.io/assets/FOTOPROFILE.png",
  canonicalUrl = "https://firdausmntp.github.io/",
} = Astro.props;

import "../styles/global.css";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Firdaus Satrio Utomo",
  "url": canonicalUrl,
  "image": image,
  "jobTitle": "Web & Mobile Developer",
  "worksFor": {
    "@type": "Organization",
    "name": "Freelance / PT Krakatau Information Technology"
  },
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "Universitas Sultan Ageng Tirtayasa"
  },
  "sameAs": [
    "https://github.com/firdausmntp",
    "https://www.linkedin.com/in/firdaus-satrio-utomo/"
  ],
  "knowsAbout": ["Web Development", "Flutter", "Laravel", "Node.js", "Reverse Engineering", "PHP", "JavaScript"]
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Firdaus Satrio Utomo, Web Developer, Mobile Developer, Flutter, Laravel, Node.js, Reverse Engineering, Portfolio, UNTIRTA" />
    <meta name="author" content="Firdaus Satrio Utomo" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#2563eb" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Firdaus Satrio Utomo Portfolio" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Favicon & Fonts -->
    <link rel="icon" type="image/png" href="/assets/FOTOPROFILE.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />

    <!-- JSON-LD Structured Data for Google Search -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <slot />
    <script is:inline src="/script.js"></script>
  </body>
</html>
