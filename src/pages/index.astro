---
import MainLayout from "../layouts/MainLayout.astro";
import Navigation from "../components/layout/Navigation.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import CoreSections from "../components/sections/CoreSections.astro";
import ProjectsSection from "../components/sections/ProjectsSection.astro";
import PreviewModal from "../components/projects/PreviewModal.astro";
---

<MainLayout
	title="Firdaus Satrio Utomo | Web & Mobile Developer - Portofolio"
	description="Portofolio resmi Firdaus Satrio Utomo - Full-stack Web & Mobile Developer (Flutter, Laravel, Node.js, React). Mahasiswa Informatika UNTIRTA IPK 3.91."
>
	<Navigation />

	<div class="container">
		<HeroSection />

		<main class="main-content">
			<CoreSections />
			<ProjectsSection />
		</main>
	</div>

	<button class="theme-toggle" id="theme-toggle-fab" type="button" aria-label="Toggle theme">
		<i class="fas fa-moon" aria-hidden="true"></i>
	</button>

	<button class="scroll-to-top" id="scrollToTop" type="button" aria-label="Scroll to top">
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5m-5 5 5-5 5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
	</button>

	<PreviewModal />
</MainLayout>
