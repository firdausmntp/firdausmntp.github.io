---
import ProjectCard from "../projects/ProjectCard.astro";
import { projectFilters, projects } from "../../data/projects";
---

<section class="section" id="projects">
  <div class="section-head">
    <h2 class="section-title">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="section-icon"><path d="m3 9 9-5 9 5-9 5-9-5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m3 14 9 5 9-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m3 19 9 5 9-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
      Proyek
    </h2>
  </div>

  <div class="project-filters">
    {
      projectFilters.map((filter, index) => (
        <button type="button" class={`filter-btn ${index === 0 ? "active" : ""}`} data-filter={filter.key}>
          {filter.label}
        </button>
      ))
    }
  </div>

  <div class="projects-grid">
    {
      projects.map((project, index) => (
        <ProjectCard project={project} featured={index === 0} />
      ))
    }
  </div>

  <div class="project-cta">
    <div class="cta-copy">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3v4m6-4v4M9 17v4m6-4v4M3 11h4m10 0h4M7 7H5a2 2 0 0 0-2 2v2m14-4h2a2 2 0 0 1 2 2v2M7 17H5a2 2 0 0 1-2-2v-2m14 4h2a2 2 0 0 0 2-2v-2M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <div>
        <h3>Jelajahi Repository saya</h3>
        <p>Lihat proyek open-source dan kontribusi lainnya di GitHub.</p>
      </div>
    </div>
    <a href="https://github.com/firdausmntp" target="_blank" rel="noreferrer" class="cta-link">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" fill="currentColor"/></svg>
      Visit GitHub Profile
    </a>
  </div>
</section>