---
import { Image } from "astro:assets";
import type { ProjectData } from "../../data/projects";

interface Props {
  project: ProjectData;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const normalizedAlt = (project.alt || "").trim().toLowerCase();
const normalizedTitle = project.title.trim().toLowerCase();
const imageAlt = normalizedAlt && normalizedAlt !== normalizedTitle
  ? project.alt
  : `Tampilan proyek ${project.title}`;

const getDomainLabel = (href: string) => {
  try {
    return new URL(href).hostname.replace(/^www\./, "");
  } catch {
    return "Visit Link";
  }
};

// Map legacy iconClass values to inline SVG icons. Keep iconClass in data for
// compatibility; render SVG only.
const githubSvg =
  '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" fill="currentColor"/></svg>';
const externalSvg =
  '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M13 3h8v8M21 3l-9 9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const imagesSvg =
  '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="8.5" cy="10" r="1.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m21 16-5-5L5 19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';

const iconSvgFor = (iconClass?: string): string => {
  if (iconClass?.includes("fa-github")) return githubSvg;
  return externalSvg;
};

const badgeClass = project.badgeColor === "danger" ? "badge-tag badge-danger" : "badge-tag badge-violet";
---

<div class={`project-card project-item${featured ? " featured" : ""}`} data-category={Array.isArray(project.category) ? project.category.join(",") : project.category}>
  <div class="project-image-container">
    <Image
      src={project.image}
      alt={imageAlt}
      class="project-image"
      width={1280}
      height={720}
      loading="lazy"
      decoding="async"
      sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
    />

    {
      project.previewGalleryId && (
        <button class="preview-gallery-btn" type="button" onclick={`openPreviewModal('${project.previewGalleryId}')`} aria-label={`Open preview gallery for ${project.title}`}>
          <Fragment set:html={imagesSvg} />
          Preview Gallery
        </button>
      )
    }

    <div class="project-overlay">
      <div class="project-links">
        {
          project.links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="project-link">
              <Fragment set:html={iconSvgFor(link.iconClass)} /> {link.label ?? getDomainLabel(link.href)}
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <div class="project-info">
    <div class="project-header">
      <h3 class="project-title">
        {project.title}
        {project.badgeText && <span class={badgeClass}>{project.badgeText}</span>}
      </h3>
      <div class="project-status-container">
        <span class={`project-status ${project.statusClass}`}>{project.statusText}</span>
        <span class={`project-repo-status ${project.repoClass}`}>{project.repoText}</span>
      </div>
    </div>
    <p class="project-description">{project.description}</p>
    <div class="project-tech">
      {
        project.tech.map((item) => (
          <span class="tech-tag">{item}</span>
        ))
      }
    </div>
  </div>
</div>